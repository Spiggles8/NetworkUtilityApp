<UserControl x:Class="NetworkUtilityApp.Views.AdaptersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="650" d:DesignWidth="1000">
    <!-- Adapters tab content: refresh control, adapters table, selection label, and network configuration form -->
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <!-- Row 0: header with Refresh button -->
            <RowDefinition Height="Auto"/>
            <!-- Row 1: adapters DataGrid -->
            <RowDefinition Height="Auto"/>
            <!-- Row 2: selected adapter label -->
            <RowDefinition Height="Auto"/>
            <!-- Row 3: network configuration form (IP/Subnet/Gateway + actions + favorites) -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header: Refresh button triggers table reload -->
        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,8">
            <Button x:Name="BtnRefresh" Content="Refresh Adapters" Padding="12,4"/>
        </StackPanel>

        <!-- Adapters grid showing current NIC info -->
        <DataGrid x:Name="DgvAdapters"
                  Grid.Row="1"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  HeadersVisibility="Column"
                  SelectionMode="Single"
                  Margin="0"
                  MaxHeight="360"
                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                  ScrollViewer.CanContentScroll="True">
            <DataGrid.Columns>
                <!-- Basic adapter properties -->
                <DataGridTextColumn Header="Adapter" Binding="{Binding AdapterName}" MinWidth="120"/>
                <DataGridTextColumn Header="DHCP" Binding="{Binding Dhcp}" MinWidth="80"/>
                <DataGridTextColumn Header="IP Address" Binding="{Binding IpAddress}" MinWidth="120"/>
                <DataGridTextColumn Header="Subnet" Binding="{Binding Subnet}" MinWidth="120"/>
                <DataGridTextColumn Header="Gateway" Binding="{Binding Gateway}" MinWidth="120"/>
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" MinWidth="100"/>
                <DataGridTextColumn Header="Hardware Details" Binding="{Binding HardwareDetails}" MinWidth="180"/>
                <DataGridTextColumn Header="MAC Address" Binding="{Binding MacAddress}" MinWidth="140"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Selected adapter label below the grid -->
        <TextBlock x:Name="LblSelectedAdapter"
                   Grid.Row="2"
                   Margin="0,8,0,8"
                   Text="Selected Adapter: None"/>

        <!-- Configuration group: octet inputs for IP/Subnet/Gateway, action buttons, and favorite presets -->
        <GroupBox Grid.Row="3" Header="Set Network Configuration" Padding="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <!-- Left columns hold labels and octet inputs -->
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <!-- Favorites right beside inputs -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- Spacer/grow -->
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- IP Address octets -->
                <TextBlock Text="IP Address:" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <StackPanel Orientation="Horizontal" Grid.Row="0" Grid.Column="1" Margin="0,0,8,0">
                    <TextBox x:Name="TxtIP1" Width="44" Margin="0,0,4,0"/>
                    <TextBox x:Name="TxtIP2" Width="44" Margin="0,0,4,0"/>
                    <TextBox x:Name="TxtIP3" Width="44" Margin="0,0,4,0"/>
                    <TextBox x:Name="TxtIP4" Width="44"/>
                </StackPanel>

                <!-- Subnet octets -->
                <TextBlock Text="Subnet Mask:" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <StackPanel Orientation="Horizontal" Grid.Row="1" Grid.Column="1" Margin="0,0,8,0">
                    <TextBox x:Name="TxtSubnet1" Width="44" Margin="0,0,4,0"/>
                    <TextBox x:Name="TxtSubnet2" Width="44" Margin="0,0,4,0"/>
                    <TextBox x:Name="TxtSubnet3" Width="44" Margin="0,0,4,0"/>
                    <TextBox x:Name="TxtSubnet4" Width="44"/>
                </StackPanel>

                <!-- Gateway octets -->
                <TextBlock Text="Gateway:" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <StackPanel Orientation="Horizontal" Grid.Row="2" Grid.Column="1" Margin="0,0,8,0">
                    <TextBox x:Name="TxtGateway1" Width="44" Margin="0,0,4,0"/>
                    <TextBox x:Name="TxtGateway2" Width="44" Margin="0,0,4,0"/>
                    <TextBox x:Name="TxtGateway3" Width="44" Margin="0,0,4,0"/>
                    <TextBox x:Name="TxtGateway4" Width="44"/>
                </StackPanel>

                <!-- DHCP / Static action buttons -->
                <StackPanel Orientation="Horizontal" Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,8,0,0">
                    <Button x:Name="BtnSetDhcp" Content="Set DHCP" Padding="8,4" Margin="0,0,8,0"/>
                    <Button x:Name="BtnSetStatic" Content="Set Static" Padding="8,4"/>
                </StackPanel>

                <!-- Favorite IP Addresses: quickly fill octets with presets -->
                <StackPanel Grid.Row="0" Grid.Column="2" Grid.RowSpan="4" Margin="12,0,0,0">
                    <TextBlock Text="Favorite IP Addresses" Margin="0,0,0,8"/>
                    <Button x:Name="BtnFavIPAddress1" Content="192.168.1.8" Margin="0,0,0,4"/>
                    <Button x:Name="BtnFavIPAddress2" Content="192.168.8.8" Margin="0,0,0,4"/>
                    <Button x:Name="BtnFavIPAddress3" Content="172.22.0.8" Margin="0,0,0,4"/>
                    <Button x:Name="BtnFavIPAddress4" Content="10.0.0.8"/>
                </StackPanel>
            </Grid>
        </GroupBox>
    </Grid>
</UserControl>
